# =========================================================
# GLOBAL / ОБЩИЕ НАСТРОЙКИ
# =========================================================
WB_TOKEN=your_wb_api_token_here
TARGET_WAREHOUSE_NAME=your_target_warehouse_name_here

# =========================================================
# STOCKS (update_stocks.py)
# =========================================================
STOCKS_DRY_RUN=true
XML_URL=your_xml_url_here
ZERO_MISSING_IN_XML=true
MIN_SAFE_STOCK=2
BATCH_SIZE=1000

# =========================================================
# CARDS (create_cards.py)
# =========================================================
CARDS_DRY_RUN=true
WB_SUBJECT_ID=your_subject_id_here
CARDS_EXCEL_FILE=new_cards.xlsx
CARDS_PROCESS_ALL_ROWS=true
CARDS_BATCH_SIZE=100
CARDS_SLEEP_BETWEEN_BATCHES=1.0

# =========================================================
# PHOTOS (upload_photos.py)
# =========================================================
PHOTOS_DRY_RUN=true
PHOTOS_EXCEL_FILE=photos.xlsx
PHOTOS_START_ROW=2
PHOTOS_SHEET_NAME=photos
PHOTOS_SLEEP=1.0

# =========================================================
# NOTIFICATIONS (универсально для разных скриптов)
# =========================================================
NOTIFY_ENABLED=true
NOTIFY_PROVIDER=brevo

# Кому отправлять уведомления
NOTIFY_TO=your_email_here

# От кого отправлять
NOTIFY_FROM_EMAIL=your_email_here
NOTIFY_FROM_NAME=Automation

# Политика успешных уведомлений:
# always | hourly | daily | never
NOTIFY_SUCCESS_POLICY=hourly

# Общий префикс темы писем
NOTIFY_SUBJECT_PREFIX=[AUTOMATION]

# Где хранить служебное состояние, чтобы не слать success слишком часто
NOTIFY_STATE_FILE=.runtime/notify_state.json

# API key Brevo
BREVO_API_KEY=your_brevo_api_key_here

HTTP_MAX_RETRIES=3
HTTP_RETRY_SLEEP_SECONDS=2